+using AuroraWKPageResumeDownloadCallback = void (*)(WKDownloadRef, const void*);
+
+extern "C" WK_EXPORT void WKPageResumeDownloadFromResumeData(
+    WKPageRef pageRef,
+    WKDataRef resumeDataRef,
+    WKStringRef pathRef,
+    const void* functionContext,
+    AuroraWKPageResumeDownloadCallback callback)
+{
+    if (!callback)
+        return;
+
+    if (!pageRef || !resumeDataRef || !pathRef) {
+        callback(nullptr, functionContext);
+        return;
+    }
+
+    protect(toImpl(pageRef))->resumeDownload(*toImpl(resumeDataRef), toWTFString(pathRef),
+        [functionContext, callback](auto* download) {
+            callback(download ? toAPI(download) : nullptr, functionContext);
+        });
+}
